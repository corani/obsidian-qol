{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"lib": ["ES2019", "DOM", "DOM.Iterable"],
		"allowImportingTsExtensions": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noImplicitAny": true,
		"strictNullChecks": true
	},
	"include": ["src/**/*.ts"]
}
